{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-recommendations",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    {
      "binding": "LMS_CACHE",
      "id": "15ec0a3673bd49de87ec203f6a356bde"
    }
  ],

  "services": [
    {
      "binding": "AI_GATEWAY",
      "service": "ai-gateway"
    }
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
