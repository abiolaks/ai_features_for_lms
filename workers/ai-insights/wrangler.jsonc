{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-insights",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "services": [
    {
      "binding": "AI_GATEWAY",
      "service": "ai-gateway"
    }
  ],

  "vars": {
    "LMS_GATEWAY_URL": "https://lms-staging-api-gpeze7brdfc9akhj.southafricanorth-01.azurewebsites.net",
    "LMS_INTERNAL_KEY": ""
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
